# vGPU-NVIDIA.so comes from the GPU-CR build image so it is version-locked
# with the cr_client the snapshot-agent ships (GEP-0001/0006 v2/v3 protocol).
ARG GPUCR_IMAGE=asia-southeast1-docker.pkg.dev/edwinhernandez-gke-dev/time-slicing/gpucr-so:gep0006-6bdce96
FROM ${GPUCR_IMAGE} AS gpucr

FROM vllm/vllm-openai:v0.22.0

WORKDIR /app

USER root
# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=gpucr /vGPU-NVIDIA.so /usr/local/lib/vGPU-NVIDIA.so
RUN chmod 755 /usr/local/lib/vGPU-NVIDIA.so

# Install the timeslice client from GitHub
RUN pip install --no-cache-dir --upgrade protobuf grpcio grpcio-tools && \
    pip install --no-cache-dir \
    "git+https://github.com/Edwinhr716/llm-d-rl-time-slicing.git@gcr-backend-memory-allocation#subdirectory=pkg/client/python"

# Copy the test script
COPY test_lora_swap_max1.py .

# Create a non-privileged user
RUN useradd -m validator && chown -R validator:validator /app
USER validator

ENTRYPOINT ["python3", "test_lora_swap_max1.py"]
